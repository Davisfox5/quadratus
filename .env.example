# =========================================================================
# Quadratus configuration
# Copy this file to .env and fill in the keys you have. The workflow runs
# with whatever providers are configured (at least one is required).
# =========================================================================

# --- Transport: subscription (CLI) vs billed API -------------------------
# "cli"  drives the vendor coding-agent CLI you are already signed into with
#        your consumer subscription (claude / codex / agy / grok). No API key
#        and no per-token billing; usage draws on the subscription's rate
#        limit window instead. This is the default.
# "api"  uses the billed HTTP SDK and needs the matching key below.
#
# Install and sign in once per provider before using "cli":
#   claude            -> Claude Pro/Max          (`claude` then /login)
#   codex login       -> ChatGPT Plus/Pro        (`codex login --device-auth` if headless)
#   agy               -> Google AI Pro/Ultra     (Antigravity CLI; replaced Gemini CLI)
#   grok login        -> SuperGrok / X Premium+
# LLM_BACKEND=cli
#
# Per-provider overrides, so you can mix (e.g. Claude on subscription,
# Gemini on an API key because the CLI is not installed).
# CLAUDE_BACKEND=cli
# OPENAI_BACKEND=cli
# GEMINI_BACKEND=api
# GROK_BACKEND=cli
#
# IMPORTANT: subscription transport authenticates as *you*. Routing anyone
# else's prompts through it violates the consumer terms of all four
# vendors, so the GUI refuses to enable public Gradio sharing while any
# provider is on "cli". Keep it local and single-user.

# --- API keys (only needed for providers set to the "api" backend) -------
# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI (ChatGPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Google (Gemini): https://aistudio.google.com/app/apikey
# Either GOOGLE_API_KEY or GEMINI_API_KEY is accepted.
GOOGLE_API_KEY=your_google_key_here

# xAI (Grok): https://console.x.ai/
# Either XAI_API_KEY or GROK_API_KEY is accepted.
XAI_API_KEY=your_xai_key_here

# --- Model selection (optional) ------------------------------------------
# Defaults are the strongest coding models from each provider. Override these
# to match the exact model IDs your accounts have access to.
# CLAUDE_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5.6-sol
# GEMINI_MODEL=gemini-3.1-pro-preview
# GROK_MODEL=grok-4.6
#
# Claude's safety classifiers can decline a request outright: the API returns
# HTTP 200 with stop_reason "refusal" and no content (Claude API since Opus
# 4.7, every Fable / Mythos model). Set a fallback and the same request is
# re-sent once to that model; leave it empty and the refusal surfaces as an
# error. Anthropic's permitted server-side fallback targets for Fable are
# claude-opus-4-8 and claude-opus-5. Use a full model ID for the API backend
# and the CLI's own alias for the CLI backend.
# CLAUDE_REFUSAL_FALLBACK_MODEL=
# CLAUDE_CLI_REFUSAL_FALLBACK_MODEL=

# --- Collaboration behaviour (optional) ----------------------------------
# Order in which providers take roles: the first is the lead implementer,
# the rest are reviewers/refiners.
# PROVIDER_ORDER=claude,openai,gemini,grok
# Number of review/refinement rounds (higher = more thorough, slower, pricier).
# ROUNDS=1
# Which provider performs the final synthesis ("lead" uses the first provider).
# SYNTHESIZER=lead

# --- CLI model tiers (optional, "cli" backend only) ----------------------
# CLI backends address models by the CLI's own alias, not a dated API ID.
# The "low" tier is used by the control plane (convergence verdicts, routing,
# refusal classification, summarisation); the "high" tier does planning,
# generation, review and synthesis. Keeping the control plane on the low tier
# is the largest single saving when every call spends subscription budget.
# CLAUDE_CLI_MODEL_HIGH=opus
# CLAUDE_CLI_MODEL_LOW=haiku
# OPENAI_CLI_MODEL_HIGH=gpt-5.6-sol
# OPENAI_CLI_MODEL_LOW=gpt-5.6-luna
# GEMINI_CLI_MODEL_HIGH=gemini-3.1-pro
# GEMINI_CLI_MODEL_LOW=gemini-3.6-flash
# GROK_CLI_MODEL_HIGH=grok-4.6
# GROK_CLI_MODEL_LOW=grok-4-1-fast

# --- Request tuning (optional) -------------------------------------------
# MAX_TOKENS=8000
# REQUEST_TIMEOUT=600
# CLI calls run a whole agent loop, not one completion, so they need a much
# more generous ceiling than an HTTP request.
# CLI_TIMEOUT=900
# MAX_RETRIES=4
# RETRY_BASE_DELAY=2

# --- GUI / file handling (optional) --------------------------------------
# MAX_MEMORY_ENTRIES=10
# MAX_FILE_BYTES=1048576
# MAX_FILE_CHARS=20000
