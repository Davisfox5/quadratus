 # ── Export ─────────────────────────────────────────────────────────────
 
+def _validate_clip_row(project, cols, width, row):
+    """Validate one CSV data row. cols maps normalised header name
+    (lower-cased, trimmed) -> column index. Returns (clip, reasons).
+
+    On success the clip dict includes a "clip_id" key (trimmed, or "")
+    for duplicate detection; the import-preview route should pop it
+    before responding.
+    """
+    if len(row) != width:
+        return None, ["wrong column count"]
+
+    def cell(name):
+        idx = cols.get(name)
+        if idx is None:
+            return None
+        return str(row[idx]).strip()
+
+    reasons = []
+
+    tag_type = cell("tag type") or ""
+    tag_names = {t["name"] for t in project.get("tag_types", [])}
+    if tag_type not in tag_names:
+        reasons.append("unknown tag type")
+
+    start_val = None
+    try:
+        parsed = float(cell("start (s)") or "")
+        if math.isfinite(parsed):
+            start_val = parsed
+            if parsed < 0:
+                reasons.append("start must be a number >= 0")
+        else:
+            reasons.append("start must be a number >= 0")
+    except (TypeError, ValueError):
+        reasons.append("start must be a number >= 0")
+
+    end_val = None
+    try:
+        parsed = float(cell("end (s)") or "")
+        if math.isfinite(parsed):
+            end_val = parsed
+            if start_val is not None and parsed <= start_val:
+                reasons.append("end must be greater than start")
+        else:
+            reasons.append("end must be a number")
+    except (TypeError, ValueError):
+        reasons.append("end must be a number")
+
+    player_ids = []
+    players_raw = cell("players")
+    if players_raw:
+        roster = project.get("players", [])
+        for token in players_raw.split(";"):
+            token = token.strip()
+            if not token:
+                continue
+            if token.startswith("#"):
+                number = token[1:].strip()
+                matches = [p for p in roster if p.get("number", "") == number]
+            else:
+                matches = [p for p in roster if p.get("name") == token]
+            if len(matches) != 1:
+                reasons.append(f"unknown player: {token}")
+            else:
+                player_ids.append(matches[0]["id"])
+
+    clip_id = cell("clip id") or ""
+    if clip_id and any(c.get("id") == clip_id for c in project.get("clips", [])):
+        reasons.append("clip id already exists")
+
+    if reasons:
+        return None, reasons
+
+    return {
+        "tag_type": tag_type,
+        "start": start_val,
+        "end": end_val,
+        "label": cell("label") or "",
+        "notes": cell("notes") or "",
+        "players": player_ids,
+        "clip_id": clip_id,
+    }, []
+
+
