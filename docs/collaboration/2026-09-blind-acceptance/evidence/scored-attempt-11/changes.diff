+# ── Clip-manifest CSV ──────────────────────────────────────────────────
+
+def _read_clip_manifest_header(raw_bytes):
+    """Decode UTF-8 clip-manifest bytes; return (columns, csv.reader).
+
+    columns are trimmed, case-folded names in file order (unknowns kept).
+    reader is strict and positioned after the header; reader.line_num is
+    the last physical line consumed (header is line 1).
+    """
+    try:
+        text = raw_bytes.decode("utf-8-sig", errors="strict")
+    except UnicodeDecodeError as exc:
+        raise ValueError("undecodable file") from exc
+
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    try:
+        header = next(reader)
+    except StopIteration:
+        raise ValueError("missing header") from None
+    except csv.Error as exc:
+        raise ValueError("invalid header quoting") from exc
+
+    columns = [name.strip().lower() for name in header]
+    if not any(columns):
+        raise ValueError("missing header")
+    required = ("tag type", "start (s)", "end (s)")
+    if any(name not in columns for name in required):
+        raise ValueError("missing required header")
+    return columns, reader
+
+
+def _resolve_clip_manifest_players(value, players):
+    """Resolve a Players cell to (player_ids, reasons).
+
+    Tokens are `;`-separated exact names or `#number` values after trim.
+    Empty/whitespace cells return ([], []). Any failing token returns
+    ([], reasons) so later row classification can mark the row malformed.
+    Token order is preserved. Input player records are not modified.
+    """
+    if not (value or "").strip():
+        return [], []
+
+    ids, reasons = [], []
+    roster = players or []
+    for raw in str(value).split(";"):
+        token = raw.strip()
+        if not token or (token.startswith("#") and not token[1:]):
+            reasons.append("empty player token")
+            continue
+        if token.startswith("#"):
+            key, field = token[1:], "number"
+        else:
+            key, field = token, "name"
+        matches = [p for p in roster if p.get(field, "") == key]
+        if len(matches) == 1:
+            ids.append(matches[0]["id"])
+        elif not matches:
+            reasons.append(f"unknown player '{token}'")
+        else:
+            reasons.append(f"ambiguous player '{token}'")
+    if reasons:
+        return [], reasons
+    return ids, []
+
