+/* ── Import preview (read-only render; no fetch, no project writes) ─ */
+function renderImportPreview(payload) {
+  const summary = payload.summary;
+  const rows = payload.rows;
+  document.getElementById("import-preview-summary").textContent =
+    `${summary.total} total, ${summary.valid} valid, ${summary.malformed} malformed, ${summary.duplicate} duplicate`;
+  document.getElementById("import-preview-status").textContent =
+    rows.length ? "" : "No clip rows to preview.";
+  const body = document.getElementById("import-preview-body");
+  body.textContent = "";
+  for (const row of rows) {
+    const tr = document.createElement("tr");
+    tr.dataset.status = row.status;
+    const clip = row.clip;
+    const clipText = clip
+      ? [clip.tag_type, `${clip.start}-${clip.end}`, clip.label, clip.notes, (clip.players || []).join(", ")]
+          .filter(part => part !== "" && part != null).join(" ")
+      : "";
+    for (const value of [row.line, row.status, clipText, (row.reasons || []).join("; ")]) {
+      const td = document.createElement("td");
+      td.textContent = value == null ? "" : String(value);
+      tr.appendChild(td);
+    }
+    body.appendChild(tr);
+  }
+}
