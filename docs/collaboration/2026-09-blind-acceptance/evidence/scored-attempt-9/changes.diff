+_REQUIRED_MANIFEST_HEADERS = ("tag type", "start (s)", "end (s)")
+
+
+def _clip_manifest_reader(content):
+    """Decode clip-manifest CSV bytes and return (headers, reader).
+
+    Headers are trimmed and lowercased. The csv.reader is positioned after
+    the header row; optional and unknown columns are retained. Physical line
+    numbers are preserved via newline='' on StringIO. Raises ValueError on
+    invalid UTF-8, missing required headers, or invalid header CSV syntax.
+    """
+    try:
+        text = content.decode("utf-8")
+    except UnicodeDecodeError as exc:
+        raise ValueError(f"file is not valid UTF-8: {exc.reason}") from exc
+    if text.startswith("\ufeff"):
+        text = text[1:]
+
+    reader = csv.reader(io.StringIO(text, newline=""), strict=True)
+    try:
+        raw_header = next(reader)
+    except StopIteration:
+        raw_header = []
+    except csv.Error as exc:
+        raise ValueError(f"invalid header CSV syntax: {exc}") from exc
+
+    headers = [cell.strip().lower() for cell in raw_header]
+    missing = [name for name in _REQUIRED_MANIFEST_HEADERS if name not in headers]
+    if missing:
+        labels = {"tag type": "Tag Type", "start (s)": "Start (s)", "end (s)": "End (s)"}
+        raise ValueError(
+            "missing required header: " + ", ".join(labels[n] for n in missing)
+        )
+    return headers, reader
+
+
+def _validate_clip_manifest_row(headers, cells, project):
+    """Return (normalized clip, reasons) for one manifest data row."""
+    if len(cells) != len(headers):
+        return None, ["wrong column count"]
+
+    values = dict(zip(headers, cells))
+    reasons = []
+    tag_type = values["tag type"].strip()
+    if tag_type not in {tag.get("name") for tag in project.get("tag_types", [])}:
+        reasons.append("unknown tag type")
+
+    parsed_times = {}
+    for header, field in (("start (s)", "start"), ("end (s)", "end")):
+        try:
+            value = float(values[header].strip())
+            if not math.isfinite(value):
+                raise ValueError
+            parsed_times[field] = value
+        except (TypeError, ValueError):
+            reasons.append(f"{field} must be a finite number")
+    if "start" in parsed_times and parsed_times["start"] < 0:
+        reasons.append("start must be non-negative")
+    if ("start" in parsed_times and "end" in parsed_times
+            and parsed_times["end"] <= parsed_times["start"]):
+        reasons.append("end must be greater than start")
+
+    player_ids = []
+    raw_players = values.get("players", "")
+    tokens = [] if not raw_players.strip() else raw_players.split(";")
+    for token in (part.strip() for part in tokens):
+        if not token:
+            reasons.append("player token must not be empty")
+            continue
+        if token.startswith("#"):
+            matches = [p for p in project.get("players", [])
+                       if p.get("number") == token[1:]]
+        else:
+            matches = [p for p in project.get("players", [])
+                       if p.get("name") == token]
+        if len(matches) != 1:
+            reasons.append(f"player '{token}' must match exactly one player")
+        else:
+            player_ids.append(matches[0]["id"])
+
+    if reasons:
+        return None, reasons
+    return {
+        "tag_type": tag_type,
+        "start": parsed_times["start"],
+        "end": parsed_times["end"],
+        "label": values.get("label", ""),
+        "notes": values.get("notes", ""),
+        "players": player_ids,
+    }, []
+
+
