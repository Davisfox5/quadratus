+# ── Clip-manifest CSV (read-only) ──────────────────────────────────────
+
+_REQUIRED_CLIP_MANIFEST_HEADERS = ("Tag Type", "Start (s)", "End (s)")
+
+
+def _read_clip_manifest_header(raw):
+    """Decode clip-manifest CSV bytes and return (headers, reader).
+
+    Headers are whitespace-trimmed; matching of required names is
+    case-insensitive. The csv.reader is positioned after the header so
+    reader.line_num counts physical lines. Raises ValueError for invalid
+    encoding, empty input, or missing required headers. Does not write.
+    """
+    try:
+        text = raw.decode("utf-8-sig", errors="strict")
+    except UnicodeDecodeError as exc:
+        raise ValueError("undecodable file") from exc
+    if not text:
+        raise ValueError("empty input")
+
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header_row = next(reader)
+    except StopIteration:
+        raise ValueError("empty input") from None
+    except csv.Error as exc:
+        raise ValueError("invalid headers") from exc
+
+    headers = [cell.strip() for cell in header_row]
+    present = {name.lower() for name in headers}
+    if any(req.lower() not in present for req in _REQUIRED_CLIP_MANIFEST_HEADERS):
+        raise ValueError("missing required header")
+    return headers, reader
+
+
