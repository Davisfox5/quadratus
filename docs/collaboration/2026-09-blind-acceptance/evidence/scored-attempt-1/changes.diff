+@app.route("/api/projects/<project_id>/clips/import_preview", methods=["POST"])
+def import_preview(project_id):
+    projects = _load_projects()
+    project = projects.get(project_id)
+    if not project:
+        return jsonify({"error": "Project not found"}), 404
+    if "file" not in request.files:
+        return jsonify({"error": "No file provided", "code": "bad_request"}), 400
+    try:
+        text = request.files["file"].read().decode("utf-8-sig")
+    except UnicodeDecodeError:
+        return jsonify({"error": "Undecodable file", "code": "bad_request"}), 400
+    reader = csv.reader(io.StringIO(text))
+    header = next(reader, [])
+    col = {h.strip().lower(): i for i, h in enumerate(header)}
+    if not {"tag type", "start (s)", "end (s)"} <= col.keys():
+        return jsonify({"error": "Missing required header", "code": "bad_request"}), 400
+    n, known = len(header), {t["name"] for t in project["tag_types"]}
+    rows, total, n_valid, n_mal = [], 0, 0, 0
+
+    def cell(rec, name):
+        i = col.get(name)
+        return rec[i].strip() if i is not None and i < len(rec) else ""
+
+    def parse_num(rec, name):
+        try:
+            value = float(cell(rec, name))
+            return value if math.isfinite(value) else None
+        except ValueError:
+            return None
+
+    while True:
+        line = reader.line_num + 1
+        rec = next(reader, None)
+        if rec is None:
+            break
+        if rec == [] or all(not c.strip() for c in rec):
+            continue
+        total += 1
+        if total > 5000:
+            return jsonify({"error": "Too many rows", "code": "too_many_rows"}), 400
+        reasons, tag = [], cell(rec, "tag type")
+        start, end = parse_num(rec, "start (s)"), parse_num(rec, "end (s)")
+        if len(rec) != n:
+            reasons.append("wrong column count")
+        if tag not in known:
+            reasons.append("unknown tag type")
+        if start is None:
+            reasons.append("start must be a number")
+        elif start < 0:
+            reasons.append("start must be >= 0")
+        if end is None:
+            reasons.append("end must be a number")
+        elif start is not None and end <= start:
+            reasons.append("end must be greater than start")
+        if reasons:
+            n_mal += 1
+            rows.append({"line": line, "status": "malformed", "reasons": reasons, "clip": None})
+        else:
+            n_valid += 1
+            rows.append({"line": line, "status": "valid", "reasons": [],
+                         "clip": {"tag_type": tag, "start": start, "end": end,
+                                  "label": cell(rec, "label"), "notes": cell(rec, "notes"),
+                                  "players": []}})
+    return jsonify({"preview_only": True,
+                    "summary": {"total": total, "valid": n_valid, "malformed": n_mal,
+                                "duplicate": 0},
+                    "rows": rows})
 
 
