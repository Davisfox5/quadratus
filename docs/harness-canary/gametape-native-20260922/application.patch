@@ -1330,6 +1331,234 @@ def export_csv(project_id):
     )
 
 
+def _preview_cell(fields, columns, name):
+    index = columns.get(name)
+    if index is None or index < 0 or index >= len(fields):
+        return ""
+    return fields[index]
+
+
+def _preview_number(raw):
+    """Parse a finite float, or None when the cell is not a finite number."""
+    try:
+        value = float(str(raw).strip())
+    except (TypeError, ValueError):
+        return None
+    if not math.isfinite(value):
+        return None
+    return value
+
+
+def _preview_players(project, raw):
+    """Resolve a Players cell. Returns (ids, reasons).
+
+    Tokens are split on `;` and stripped; empty tokens are dropped. A token
+    starting with `#` matches `number` using the text after `#` up to the first
+    whitespace (export form `#7 Alice` or bare `#7`). Any other token matches
+    `name` case-insensitively. One match appends that id; zero or several
+    matches append a reason and no id. A missing or empty cell yields `([], [])`.
+    """
+    ids = []
+    reasons = []
+    players = project.get("players") or []
+    for token in str(raw).split(";"):
+        token = token.strip()
+        if not token:
+            continue
+        if token.startswith("#"):
+            rest = token[1:]
+            number = rest[:next((i for i, ch in enumerate(rest) if ch.isspace()), len(rest))]
+            matches = [p for p in players if p.get("number") == number]
+        else:
+            needle = token.lower()
+            matches = [p for p in players if str(p.get("name", "")).lower() == needle]
+        if len(matches) == 1:
+            ids.append(matches[0]["id"])
+        elif not matches:
+            reasons.append(f"unknown player: {token}")
+        else:
+            reasons.append(f"ambiguous player: {token}")
+    return ids, reasons
+
+
+def _preview_row_clip(project, columns, fields):
+    """Validate one manifest row. Returns (clip, reasons); clip is None if reasons is non-empty.
+
+    `columns` maps a header name (stripped, lowercased) to its field index.
+    Clip ID checks are intentionally not applied here. A missing Players
+    column yields an empty player list.
+    """
+    header_width = max(columns.values(), default=-1) + 1
+    if len(fields) != header_width:
+        return None, ["wrong number of columns"]
+
+    reasons = []
+    tag_type = _preview_cell(fields, columns, "tag type").strip()
+    known = {t.get("name") for t in project.get("tag_types", [])}
+    if "tag type" not in columns or tag_type not in known:
+        reasons.append("unknown tag type")
+
+    start = _preview_number(_preview_cell(fields, columns, "start (s)"))
+    if "start (s)" not in columns or start is None or start < 0:
+        reasons.append("start must be a finite number >= 0")
+        start = None
+
+    end = _preview_number(_preview_cell(fields, columns, "end (s)"))
+    if "end (s)" not in columns or end is None:
+        reasons.append("end must be a finite number")
+    elif start is not None and not end > start:
+        reasons.append("end must be greater than start")
+
+    player_ids, player_reasons = _preview_players(
+        project, _preview_cell(fields, columns, "players")
+    )
+    reasons.extend(player_reasons)
+
+    if reasons:
+        return None, reasons
+
+    return {
+        "tag_type": tag_type,
+        "start": start,
+        "end": end,
+        "label": _preview_cell(fields, columns, "label"),
+        "notes": _preview_cell(fields, columns, "notes"),
+        "players": player_ids,
+    }, []
+
+
+def _preview_row_key(columns, fields):
+    """Comparable key (tag_type, start, end, label) for duplicate history, or None.
+
+    None when the column count is wrong or Start (s)/End (s) is not a finite
+    number: such rows are never comparable and must not be remembered.
+    """
+    header_width = max(columns.values(), default=-1) + 1
+    if len(fields) != header_width:
+        return None
+    start = _preview_number(_preview_cell(fields, columns, "start (s)"))
+    end = _preview_number(_preview_cell(fields, columns, "end (s)"))
+    if start is None or end is None:
+        return None
+    return (
+        _preview_cell(fields, columns, "tag type").strip(),
+        start,
+        end,
+        _preview_cell(fields, columns, "label"),
+    )
+
+
+def _preview_duplicate(project, seen_keys, seen_ids, columns, fields, clip):
+    """Return a duplicate reason, or None when the row is new.
+
+    `seen_keys` maps (tag_type, start, end, label) to the first physical line
+    that key appeared on. `seen_ids` maps a Clip ID to the first physical line
+    that id appeared on. Both dicts hold that line regardless of the earlier
+    row's status. The caller records an id or key only after this check.
+    """
+    clip_id = _preview_cell(fields, columns, "clip id").strip()
+    if clip_id:
+        if any(c["id"] == clip_id for c in project.get("clips", [])):
+            return "clip id already exists"
+        if clip_id in seen_ids:
+            return f"same clip id as line {seen_ids[clip_id]}"
+    key = (clip["tag_type"], clip["start"], clip["end"], clip["label"])
+    if key in seen_keys:
+        return f"same as line {seen_keys[key]}"
+    return None
+
+
+@app.route("/api/projects/<project_id>/clips/import_preview", methods=["POST"])
+def import_preview(project_id):
+    """Read-only CSV clip-manifest preview. Never writes the project store."""
+    projects = _load_projects()
+    project = projects.get(project_id)
+    if not project:
+        return jsonify({"error": "Project not found"}), 404
+
+    upload = request.files.get("file")
+    if upload is None:
+        return jsonify({"error": "No file provided", "code": "bad_request"}), 400
+
+    try:
+        text = upload.read().decode("utf-8-sig")
+    except UnicodeDecodeError:
+        return jsonify({"error": "File could not be decoded as UTF-8", "code": "bad_request"}), 400
+
+    reader = csv.reader(io.StringIO(text))
+    try:
+        header = next(reader)
+    except StopIteration:
+        header = []
+
+    columns = {name.strip().lower(): index for index, name in enumerate(header)}
+    for required in ("tag type", "start (s)", "end (s)"):
+        if required not in columns:
+            return jsonify({"error": "Missing required header", "code": "bad_request"}), 400
+
+    rows = []
+    valid = 0
+    malformed = 0
+    duplicate = 0
+    seen_keys = {}
+    seen_ids = {}
+    while True:
+        # line_num is the last physical line already consumed, so the next
+        # record starts on the following line — including a quoted field that
+        # spans several physical lines (csv.reader reports the last of those).
+        start_line = reader.line_num + 1
+        try:
+            fields = next(reader)
+        except StopIteration:
+            break
+        if not fields or all(cell == "" for cell in fields):
+            continue
+        if valid + malformed + duplicate >= 5000:
+            return jsonify({"error": "Too many rows", "code": "too_many_rows"}), 400
+
+        clip, reasons = _preview_row_clip(project, columns, fields)
+        key = _preview_row_key(columns, fields)
+        if reasons:
+            status = "malformed"
+            malformed += 1
+        else:
+            reason = _preview_duplicate(project, seen_keys, seen_ids, columns, fields, clip)
+            if reason:
+                status = "duplicate"
+                reasons = [reason]
+                clip = None
+                duplicate += 1
+            else:
+                status = "valid"
+                valid += 1
+        # Record after the status check so this row is not a duplicate of itself.
+        # A Clip ID counts from any earlier physical row, including malformed ones.
+        # A comparable key counts from any earlier row whose times parse.
+        cid = _preview_cell(fields, columns, "clip id").strip()
+        if cid:
+            seen_ids.setdefault(cid, start_line)
+        if key is not None:
+            seen_keys.setdefault(key, start_line)
+        rows.append({
+            "line": start_line,
+            "status": status,
+            "reasons": reasons,
+            "clip": clip,
+        })
+
+    total = valid + malformed + duplicate
+    return jsonify({
+        "preview_only": True,
+        "summary": {
+            "total": total,
+            "valid": valid,
+            "malformed": malformed,
+            "duplicate": duplicate,
+        },
+        "rows": rows,
+    })
+
+
 @app.route("/api/projects/<project_id>/export/json")
 def export_json(project_id):
     projects = _load_projects()
