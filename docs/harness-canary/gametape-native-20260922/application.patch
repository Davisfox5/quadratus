+    assert rows[1]["clip"] is None
+    assert rows[2]["status"] == "malformed"
+    assert rows[2]["reasons"] == ["unknown player: Nobody"]
+    assert rows[2]["clip"] is None
+    assert body["summary"] == {"total": 3, "valid": 1, "malformed": 1, "duplicate": 1}
