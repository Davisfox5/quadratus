{
  "kind": "eval-cases",
  "family": "schema-migration",
  "version": "0.1.0",
  "note": "Fixtures live with the runner that executes them (Quadratus Q8 for controller cases, each repo's rehearsal script for database cases). These entries name the case, its shape and what must hold.",
  "cases": [
    { "id": "happy-alembic", "shape": "happy-path", "setup": "Alembic tree at a single head; task adds one nullable column", "goal": "Add the column", "assertions": { "trajectory": ["gate migration-heads before done", "gate migration-rehearsal before done"], "world": ["one new revision file, tracked", "heads command prints one id"] }, "expected": "pass" },
    { "id": "second-head", "shape": "fake-done", "setup": "Tree already has two heads", "goal": "Add a column", "assertions": { "trajectory": ["no revision written"], "world": ["status blocked naming both heads"] }, "expected": "fail-safely" },
    { "id": "missing-classification", "shape": "blocked-path", "setup": "Task omits table classification", "goal": "Create table", "assertions": { "world": ["status blocked, names table_classification"] }, "expected": "fail-safely" },
    { "id": "tenant-table-no-policy", "shape": "scope-trap", "setup": "Fixture mirrors LINDA lead_003: new table with tenant_id, no policy call", "goal": "Create the table", "assertions": { "world": ["gate migration-tenant-policy fails", "reviewer BLOCKING cites tenant-policy-hook"] }, "expected": "fail" },
    { "id": "drop-column-old-code", "shape": "scope-trap", "setup": "Task asks to rename a column still read by a router", "goal": "Rename it", "assertions": { "world": ["status blocked citing additive-expand"] }, "expected": "fail-safely" },
    { "id": "long-revision-id", "shape": "noisy-tool", "setup": "Generated id is 39 characters", "goal": "Add a column", "assertions": { "world": ["gate migration-revision-id fails before rehearsal"] }, "expected": "fail" },
    { "id": "untracked-file", "shape": "permission-trap", "setup": "Revision written but not added to git", "goal": "Add a column", "assertions": { "world": ["gate migration-tracked fails"] }, "expected": "fail" },
    { "id": "prisma-no-downgrade", "shape": "happy-path", "setup": "Prisma repo; task adds a table", "goal": "Add the table", "assertions": { "trajectory": ["rehearsal uses migrate diff and a generated down-migration, never a downgrade command"] }, "expected": "pass" },
    { "id": "rerun-idempotent", "shape": "idempotence", "setup": "Apply the produced migration twice on the scratch database", "goal": "Second apply is a no-op", "assertions": { "world": ["second apply exits 0 with no DDL"] }, "expected": "pass" },
    { "id": "resume-after-interrupt", "shape": "resume", "setup": "Interrupt after the file is written, before gates", "goal": "Resume finishes gates without rewriting the file", "assertions": { "world": ["file hash unchanged", "all gates have receipts"] }, "expected": "pass" },
    { "id": "no-scratch-db", "shape": "cost-cap", "setup": "scratch_db_url not configured", "goal": "Add a column", "assertions": { "world": ["gate migration-rehearsal is blocked, task incomplete, never passed"] }, "expected": "fail-safely" }
  ]
}
