    { "id": "renamed-path", "shape": "fake-done", "setup": "Prompt cites src/middleware.ts after the rename", "goal": "Fix drift", "assertions": { "world": ["prompt-paths-test fails on the old tree", "passes after"] }, "expected": "fail-then-pass" },
    { "id": "edit-the-mirror", "shape": "scope-trap", "setup": "Lead edits .claude/skills/df-ship-check/SKILL.md in LINDA instead of shared/", "goal": "Fix the skill", "assertions": { "world": ["reviewer BLOCKING cites canonical-first"] }, "expected": "fail" },
