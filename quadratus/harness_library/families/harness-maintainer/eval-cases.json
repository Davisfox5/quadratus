    { "id": "rerun-fresh", "shape": "idempotence", "setup": "Facts already match", "goal": "Refresh", "assertions": { "world": ["no diff", "gates pass"] }, "expected": "pass" },
    { "id": "rule-without-because", "shape": "scope-trap", "setup": "New checklist line has no because", "goal": "Add a rule", "assertions": { "world": ["reviewer cites because-on-every-rule"] }, "expected": "fail" },
    { "id": "invalid-policy", "shape": "fake-done", "setup": "Policy edit leaves a trailing comma", "goal": "Add a gate", "assertions": { "world": ["harness-validate fails", "guard hook would deny every write"] }, "expected": "fail-then-pass" },
